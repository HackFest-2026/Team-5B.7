# Monetize360 — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# The .env file is excluded from version control via .gitignore.

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS.
# In production, set this to the exact frontend origin(s), e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# In local development (default) the Vite dev server runs on port 5173.
# Setting to "*" with credentials=True is a browser security error; do not do that.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# API Key (Write Operations Guard)
# ---------------------------------------------------------------------------
# When set, all mutating operations (draft, publish, rollback, lifecycle
# transitions) require the caller to supply this key in the
# X-API-Key HTTP request header.
#
# In development, leave unset (blank) to allow unauthenticated local usage.
# A warning is logged at startup when this key is absent.
# NEVER commit a real key to version control.
#
# Example:
#   API_KEY=change-me-to-a-long-random-secret
API_KEY=

# ---------------------------------------------------------------------------
# Database path (optional override)
# ---------------------------------------------------------------------------
# Defaults to api/data/monetize360.db relative to the project root.
# Override only if you need to point to a different SQLite file.
# DB_PATH=/var/data/monetize360.db

# ---------------------------------------------------------------------------
# Environment label
# ---------------------------------------------------------------------------
# Used in logs and health responses.  Values: development | staging | production
APP_ENV=development

# ---------------------------------------------------------------------------
# Governance & Role Separation Defaults
# ---------------------------------------------------------------------------
# Require drafts to be explicitly approved before publishing (default: false in dev).
# In production, set to true to enforce review workflow.
REQUIRE_APPROVAL=false

# Enforce four-eyes principle (author cannot approve/publish their own pack)
# by default on all lifecycle transitions (default: false in dev).
ENFORCE_ROLE_SEPARATION=false
